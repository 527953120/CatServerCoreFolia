diff --git a/src/test/java/org/bukkit/craftbukkit/entity/CraftPlayerVisibilityTest.java b/src/test/java/org/bukkit/craftbukkit/entity/CraftPlayerVisibilityTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..c799e0929d7619922fd002268f7fe2e412a0e117
--- /dev/null
+++ b/src/test/java/org/bukkit/craftbukkit/entity/CraftPlayerVisibilityTest.java
@@ -0,0 +1,190 @@
+package org.bukkit.craftbukkit.entity;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import java.lang.reflect.Method;
+import java.util.UUID;
+import java.util.concurrent.Callable;
+import java.util.concurrent.CyclicBarrier;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import net.minecraft.server.dedicated.DedicatedPlayerList;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.EntityType;
+import org.bukkit.GameMode;
+import org.bukkit.craftbukkit.CraftServer;
+import org.bukkit.entity.Entity;
+import org.bukkit.plugin.Plugin;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.Test;
+
+@VanillaFeature
+public class CraftPlayerVisibilityTest {
+    private static final int CONCURRENT_ROUNDS = 250;
+
+    // Exercise the state transitions without running trackers or plugin events off-thread.
+    private static boolean change(CraftPlayer player, String methodName, Plugin plugin, Entity entity) throws Exception {
+        Method method = CraftPlayer.class.getDeclaredMethod(methodName, Plugin.class, Entity.class);
+        method.setAccessible(true);
+        return (boolean) method.invoke(player, plugin, entity);
+    }
+
+    private static CraftPlayer createPlayer() {
+        CraftServer server = mock(CraftServer.class);
+        when(server.getDefaultGameMode()).thenReturn(GameMode.SURVIVAL);
+        when(server.getHandle()).thenReturn(mock(DedicatedPlayerList.class));
+        ServerPlayer handle = mock(ServerPlayer.class);
+        doReturn(EntityType.PLAYER).when(handle).getType();
+        when(handle.getUUID()).thenReturn(UUID.randomUUID());
+        return new CraftPlayer(server, handle);
+    }
+
+    private static Entity createEntity(boolean visibleByDefault) {
+        Entity entity = mock(Entity.class);
+        when(entity.getUniqueId()).thenReturn(UUID.randomUUID());
+        when(entity.isVisibleByDefault()).thenReturn(visibleByDefault);
+        return entity;
+    }
+
+    @Test
+    public void visibilityChangesOnlyOnFirstRegistrationAndLastRemoval() throws Exception {
+        CraftPlayer player = createPlayer();
+        Entity entity = createEntity(true);
+        Plugin first = mock(Plugin.class);
+        Plugin second = mock(Plugin.class);
+        Plugin unrelated = mock(Plugin.class);
+
+        assertTrue(player.canSee(entity));
+        assertTrue(change(player, "addInvertedVisibility", first, entity));
+        assertFalse(change(player, "addInvertedVisibility", first, entity));
+        assertFalse(change(player, "addInvertedVisibility", second, entity));
+        assertFalse(player.canSee(entity));
+        assertFalse(change(player, "removeInvertedVisibility", unrelated, entity));
+        assertFalse(change(player, "removeInvertedVisibility", first, entity));
+        assertFalse(change(player, "removeInvertedVisibility", first, entity));
+        assertFalse(player.canSee(entity));
+        assertTrue(change(player, "removeInvertedVisibility", second, entity));
+        assertFalse(change(player, "removeInvertedVisibility", second, entity));
+        assertTrue(player.canSee(entity));
+    }
+
+    @Test
+    public void legacyNullPluginAndInvisibleByDefaultKeepTheirSemantics() throws Exception {
+        CraftPlayer player = createPlayer();
+        Entity entity = createEntity(false);
+        assertFalse(player.canSee(entity));
+        assertTrue(change(player, "addInvertedVisibility", null, entity));
+        assertFalse(change(player, "addInvertedVisibility", null, entity));
+        assertTrue(player.canSee(entity));
+        assertTrue(change(player, "removeInvertedVisibility", null, entity));
+        assertFalse(player.canSee(entity));
+    }
+
+    @Test
+    public void concurrentRegistrationKeepsBothPluginsAndOneTransition() throws Exception {
+        CraftPlayer player = createPlayer();
+        Entity entity = createEntity(true);
+        Plugin first = mock(Plugin.class);
+        Plugin second = mock(Plugin.class);
+        runConcurrently(
+            () -> change(player, "addInvertedVisibility", first, entity),
+            () -> change(player, "addInvertedVisibility", second, entity),
+            () -> assertTrue(player.canSee(entity)),
+            (firstChanged, secondChanged) -> {
+                assertNotEquals(firstChanged, secondChanged, "Only the first plugin changes visibility");
+                assertFalse(change(player, "removeInvertedVisibility", first, entity));
+                assertTrue(change(player, "removeInvertedVisibility", second, entity));
+                assertTrue(player.canSee(entity));
+            }
+        );
+    }
+
+    @Test
+    public void concurrentRemovalReportsOnlyTheLastTransition() throws Exception {
+        CraftPlayer player = createPlayer();
+        Entity entity = createEntity(true);
+        Plugin first = mock(Plugin.class);
+        Plugin second = mock(Plugin.class);
+        runConcurrently(
+            () -> change(player, "removeInvertedVisibility", first, entity),
+            () -> change(player, "removeInvertedVisibility", second, entity),
+            () -> {
+                assertTrue(change(player, "addInvertedVisibility", first, entity));
+                assertFalse(change(player, "addInvertedVisibility", second, entity));
+            },
+            (firstChanged, secondChanged) -> {
+                assertNotEquals(firstChanged, secondChanged, "Only the last plugin changes visibility");
+                assertTrue(player.canSee(entity));
+            }
+        );
+    }
+
+    @Test
+    public void entityRemovalCanRaceWithVisibilityRegistration() throws Exception {
+        CraftPlayer player = createPlayer();
+        Entity entity = createEntity(true);
+        net.minecraft.world.entity.Entity removed = mock(net.minecraft.world.entity.Entity.class);
+        final UUID entityId = entity.getUniqueId();
+        when(removed.getUUID()).thenReturn(entityId);
+        Plugin plugin = mock(Plugin.class);
+        runConcurrently(
+            () -> change(player, "addInvertedVisibility", plugin, entity),
+            () -> {
+                player.onEntityRemove(removed);
+                return player.canSee(entity);
+            },
+            () -> assertTrue(player.canSee(entity)),
+            (registered, visibleDuringRemoval) -> {
+                assertTrue(registered);
+                player.onEntityRemove(removed);
+                assertTrue(player.canSee(entity));
+            }
+        );
+    }
+
+    private static void runConcurrently(Callable<Boolean> first, Callable<Boolean> second, CheckedAction before, CheckedResults after) throws Exception {
+        CyclicBarrier barrier = new CyclicBarrier(3);
+        boolean[] firstResults = new boolean[CONCURRENT_ROUNDS];
+        boolean[] secondResults = new boolean[CONCURRENT_ROUNDS];
+        ExecutorService executor = Executors.newFixedThreadPool(2);
+        try {
+            Future<?> firstTask = submit(executor, barrier, first, firstResults);
+            Future<?> secondTask = submit(executor, barrier, second, secondResults);
+            for (int round = 0; round < CONCURRENT_ROUNDS; ++round) {
+                before.run();
+                barrier.await(5, TimeUnit.SECONDS);
+                barrier.await(5, TimeUnit.SECONDS);
+                after.accept(firstResults[round], secondResults[round]);
+            }
+            firstTask.get(5, TimeUnit.SECONDS);
+            secondTask.get(5, TimeUnit.SECONDS);
+        } finally {
+            executor.shutdownNow();
+            assertTrue(executor.awaitTermination(5, TimeUnit.SECONDS), "Visibility workers must stop");
+        }
+    }
+
+    private static Future<?> submit(ExecutorService executor, CyclicBarrier barrier, Callable<Boolean> operation, boolean[] results) {
+        return executor.submit(() -> {
+            for (int round = 0; round < CONCURRENT_ROUNDS; ++round) {
+                barrier.await(5, TimeUnit.SECONDS);
+                results[round] = operation.call();
+                barrier.await(5, TimeUnit.SECONDS);
+            }
+            return null;
+        });
+    }
+
+    @FunctionalInterface
+    private interface CheckedAction {
+        void run() throws Exception;
+    }
+
+    @FunctionalInterface
+    private interface CheckedResults {
+        void accept(boolean first, boolean second) throws Exception;
+    }
+}
