         }
-        invertedPlugins.remove(CraftPlayer.getPluginWeakReference(plugin));
-        if (!invertedPlugins.isEmpty()) {
-            return false; // Some other plugins still want the entity inverted
+        // Folia end - atomically update the map and its plugin set
+    }
+
+    // Folia start - shared visibility state access, with tracking and events outside the lock
+    // Return true when no inversion existed, matching the reset methods' tracking decision.
+    private boolean clearInvertedVisibility(UUID entityId) {
+        synchronized (this.invertedVisibilityLock) {
+            return this.invertedVisibilityEntities.remove(entityId) == null;
         }
-        this.invertedVisibilityEntities.remove(entity.getUniqueId());
+    }
 
-        return true;
+    private boolean hasInvertedVisibility(UUID entityId) {
+        synchronized (this.invertedVisibilityLock) {
+            return this.invertedVisibilityEntities.containsKey(entityId);
+        }
     }
+    // Folia end - shared visibility state access, with tracking and events outside the lock
 
     private void trackAndShowEntity(org.bukkit.entity.Entity entity) {
         this.trackAndShowEntity(entity, null);
@@ -2047,7 +2083,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
             return;
         }
 
-        if (this.invertedVisibilityEntities.remove(entity.getUniqueId()) == null) {
+        if (this.clearInvertedVisibility(entity.getUniqueId())) { // Folia - synchronize visibility state only, not tracking or events
             this.trackAndShowEntity(entity);
         }
     }
@@ -2080,7 +2116,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     // Paper end
 
     public void onEntityRemove(Entity entity) {
-        this.invertedVisibilityEntities.remove(entity.getUUID());
+        this.clearInvertedVisibility(entity.getUUID()); // Folia - removal may run on another region
     }
 
     @Override
@@ -2090,7 +2126,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
 
