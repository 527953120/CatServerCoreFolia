From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 527953120 <3091193455@qq.com>
Date: Fri, 13 Nov 2026 07:36:35 +0800
Subject: [PATCH] Synchronize player visibility state across region removal

Fix the shared map, nested plugin sets, and first/last inversion transitions from Folia issue #406. All state access uses a per-player lock; tracking, packets, and plugin events stay outside it. Synchronize the shared weak-reference cache separately without nested locks. Add 5 regression tests including concurrent registration, removal, and visibility reads. This does not make arbitrary off-thread tracker calls supported.

diff --git a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
index 403859ddf90036dc812eab707cd06499c6dbf8f7..71ac6dc3b99832d004edcc61d7027e0685e7aefa 100644
--- a/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
+++ b/src/main/java/org/bukkit/craftbukkit/entity/CraftPlayer.java
@@ -234,7 +234,11 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     private long lastPlayed = 0;
     private boolean hasPlayedBefore = false;
     private final ConversationTracker conversationTracker = new ConversationTracker();
+    // Folia start - protect visibility state shared with entity removal on other regions
+    private final Object invertedVisibilityLock = new Object();
+    // Both this map and its plugin sets are guarded by invertedVisibilityLock.
     private final Map<UUID, Set<WeakReference<Plugin>>> invertedVisibilityEntities = new HashMap<>();
+    // Folia end - protect visibility state shared with entity removal on other regions
     private final Set<UUID> unlistedEntities = new HashSet<>(); // Paper - Add Listing API for Player
     private static final WeakHashMap<Plugin, WeakReference<Plugin>> pluginWeakReferences = new WeakHashMap<>();
     private int hash = 0;
@@ -1851,7 +1855,12 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     }
 
     private static @Nullable WeakReference<Plugin> getPluginWeakReference(@Nullable Plugin plugin) {
-        return (plugin == null) ? null : CraftPlayer.pluginWeakReferences.computeIfAbsent(plugin, WeakReference::new);
+        // Folia start - the reference cache is shared by players on different regions
+        if (plugin == null) return null;
+        synchronized (CraftPlayer.pluginWeakReferences) {
+            return CraftPlayer.pluginWeakReferences.computeIfAbsent(plugin, WeakReference::new);
+        }
+        // Folia end - the reference cache is shared by players on different regions
     }
 
     @Override
@@ -1886,18 +1895,24 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     }
 
     private boolean addInvertedVisibility(@Nullable Plugin plugin, org.bukkit.entity.Entity entity) {
-        Set<WeakReference<Plugin>> invertedPlugins = this.invertedVisibilityEntities.get(entity.getUniqueId());
-        if (invertedPlugins != null) {
-            // Some plugins are already inverting the entity. Just mark that this
-            // plugin wants the entity inverted too and end.
-            invertedPlugins.add(CraftPlayer.getPluginWeakReference(plugin));
-            return false;
-        }
-        invertedPlugins = new HashSet<>();
-        invertedPlugins.add(CraftPlayer.getPluginWeakReference(plugin));
-        this.invertedVisibilityEntities.put(entity.getUniqueId(), invertedPlugins);
+        // Folia start - atomically update the map and its plugin set
+        final UUID entityId = entity.getUniqueId();
+        final WeakReference<Plugin> pluginReference = CraftPlayer.getPluginWeakReference(plugin);
+        synchronized (this.invertedVisibilityLock) {
+            Set<WeakReference<Plugin>> invertedPlugins = this.invertedVisibilityEntities.get(entityId);
+            if (invertedPlugins != null) {
+                // Some plugins are already inverting the entity. Just mark that this
+                // plugin wants the entity inverted too and end.
+                invertedPlugins.add(pluginReference);
+                return false;
+            }
+            invertedPlugins = new HashSet<>();
+            invertedPlugins.add(pluginReference);
+            this.invertedVisibilityEntities.put(entityId, invertedPlugins);
 
-        return true;
+            return true;
+        }
+        // Folia end - atomically update the map and its plugin set
     }
 
     private void untrackAndHideEntity(org.bukkit.entity.Entity entity) {
@@ -1931,7 +1946,7 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
             return;
         }
 
-        if (this.invertedVisibilityEntities.remove(entity.getUniqueId()) == null) {
+        if (this.clearInvertedVisibility(entity.getUniqueId())) { // Folia - synchronize visibility state only, not tracking or events
             this.untrackAndHideEntity(entity);
         }
     }
@@ -1968,18 +1983,39 @@ public class CraftPlayer extends CraftHumanEntity implements Player, PluginMessa
     }
 
     private boolean removeInvertedVisibility(@Nullable Plugin plugin, org.bukkit.entity.Entity entity) {
-        Set<WeakReference<Plugin>> invertedPlugins = this.invertedVisibilityEntities.get(entity.getUniqueId());
-        if (invertedPlugins == null) {
-            return false; // Entity isn't inverted
+        // Folia start - atomically update the map and its plugin set
+        final UUID entityId = entity.getUniqueId();
+        final WeakReference<Plugin> pluginReference = CraftPlayer.getPluginWeakReference(plugin);
+        synchronized (this.invertedVisibilityLock) {
+            Set<WeakReference<Plugin>> invertedPlugins = this.invertedVisibilityEntities.get(entityId);
+            if (invertedPlugins == null) {
+                return false; // Entity isn't inverted
+            }
+            invertedPlugins.remove(pluginReference);
+            if (!invertedPlugins.isEmpty()) {
+                return false; // Some other plugins still want the entity inverted
+            }
+            this.invertedVisibilityEntities.remove(entityId);
+
