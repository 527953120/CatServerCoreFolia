From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 527953120 <3091193455@qq.com>
Date: Fri, 13 Nov 2026 07:35:28 +0800
Subject: [PATCH] Disable unsafe shared server debug subscriptions

Mitigate Folia issues #472 and #432 using the conservative direction of PR #499. ServerPlayer exposes no effective subscriptions and the subscriber service is stateless and inert. This deliberately disables server-provided debug feeds such as MiniHUD until their source and subscriber state is region-owned; a map snapshot alone cannot fix the shared synchronizers.

diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 01e067a0045e59094bf271c448f158f932199aa3..bcb7013c3d11ee74ff5f97b6fc0f6ce1915caf71 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -3460,7 +3460,8 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     }
 
     public Set<DebugSubscription<?>> debugSubscriptions() {
-        return !this.server.debugSubscribers().hasRequiredPermissions(this) ? Set.of() : this.requestedDebugSubscriptions;
+        // Folia - region threading - shared debug synchronizers are unsafe (PaperMC/Folia#499).
+        return Set.of(); // Disables server-provided debug data, including MiniHUD subscriptions.
     }
 
     public record RespawnConfig(LevelData.RespawnData respawnData, boolean forced) {
diff --git a/net/minecraft/util/debug/ServerDebugSubscribers.java b/net/minecraft/util/debug/ServerDebugSubscribers.java
index a700521a74b7e8b0c3000df18dce85592f01e568..49e58d113c71a6996e9ac3b9593b588d86b47d2b 100644
--- a/net/minecraft/util/debug/ServerDebugSubscribers.java
+++ b/net/minecraft/util/debug/ServerDebugSubscribers.java
@@ -1,56 +1,31 @@
